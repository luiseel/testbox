{
  "name": "testbox",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted machine for coding agents to run builds and tests on. Copies the working tree to a worker, runs a command, and returns the log and an exit code; with --json, as NDJSON with a hint on failure.",
  "scripts": {
    "build": "tsrs -b",
    "typecheck": "tsrs -b --pretty false",
    "test": "bash scripts/test.sh",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt",
    "start:api": "node packages/api/dist/main.js",
    "start:worker": "node packages/worker/dist/main.js"
  },
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@nestjs/core",
      "msgpackr-extract"
    ]
  }
}
