# Control plane settings for docker compose. `testbox admin init-control-plane`
# writes this file as .env with random secrets; copy it only for local work.
TESTBOX_WORKER_TOKEN=dev-worker-token
# Admin token: create users and their tokens with it.
TESTBOX_BOOTSTRAP_TOKEN=dev-bootstrap-token
# Workers on other hosts use it in REDIS_URL. Empty means no password.
TESTBOX_REDIS_PASSWORD=
TESTBOX_DATA_DIR=./data
TESTBOX_API_PORT=3000
TESTBOX_REDIS_PORT=6379
