[Unit]
Description=Testbox worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
__USER_LINE__
WorkingDirectory=__REPO__
Environment=HOME=__HOME__
Environment=REDIS_URL=__REDIS_URL__
Environment=TESTBOX_DATA_DIR=__DATA_DIR__
Environment=TESTBOX_WORKER_ID=__WORKER_ID__
Environment=TESTBOX_API_URL=__API_URL__
Environment=TESTBOX_WORKER_TOKEN=__WORKER_TOKEN__
Environment=TESTBOX_SSH_HOST=__SSH_HOST__
Environment=TESTBOX_CAPACITY=__CAPACITY__
Environment=PATH=__PATH__
ExecStart=__NODE__ __REPO__/packages/worker/dist/main.js
Restart=always
RestartSec=2
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=__WANTED_BY__
