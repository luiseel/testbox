<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.testbox.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/packages/worker/dist/main.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>REDIS_URL</key>
    <string>__REDIS_URL__</string>
    <key>TESTBOX_DATA_DIR</key>
    <string>__DATA_DIR__</string>
    <key>TESTBOX_WORKER_ID</key>
    <string>__WORKER_ID__</string>
    <key>TESTBOX_API_URL</key>
    <string>__API_URL__</string>
    <key>TESTBOX_WORKER_TOKEN</key>
    <string>__WORKER_TOKEN__</string>
    <key>TESTBOX_LABELS</key>
    <string>macos,arm64,xcode,ios-simulator,node,pnpm,playwright</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__DATA_DIR__/logs/worker.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__DATA_DIR__/logs/worker.stderr.log</string>
</dict>
</plist>
