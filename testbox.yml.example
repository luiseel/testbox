project: example-app
ignore:
  - node_modules
  - dist
  - .git
  - coverage
  - '**/*.log'
profiles:
  typecheck:
    command: pnpm typecheck
    resources: light
  unit:
    command: pnpm test
    resources: light
  playwright:
    command: pnpm exec playwright test
    resources: exclusive
    artifacts:
      - playwright-report/**
      - test-results/**
  ios:
    command: xcodebuild test -scheme App -destination 'platform=iOS Simulator,name=iPhone 16'
    resources: exclusive
    artifacts:
      - '*.xcresult/**'
      - DerivedData/Logs/**