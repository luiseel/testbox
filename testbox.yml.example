project: example-app
ignore:
  - node_modules
  - dist
  - .git
  - coverage
  - '**/*.log'
profiles:
  typecheck:
    command: pnpm typecheck
  unit:
    command: pnpm test
  e2e:
    command: pnpm exec playwright test
  playwright:
    command: pnpm exec playwright test
    artifacts:
      - playwright-report/**
      - test-results/**
  ios:
    command: xcodebuild test -scheme App -destination 'platform=iOS Simulator,name=iPhone 16'
    requires:
      - macos
      - xcode
    artifacts:
      - '*.xcresult/**'
      - DerivedData/Logs/**